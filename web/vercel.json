{
  "build": {
    "env": {
      "NEXT_PUBLIC_PROTOTYPE": "1",
      "NEXT_PUBLIC_DEMO_KEY": "demo123",
      "NEXT_PUBLIC_API_BASE_URL": "/api"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?__p=:path*" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "api/_slotpay/**"
    }
  }
}
