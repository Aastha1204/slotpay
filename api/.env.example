# Server-side only. Never commit real values.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Use ONE of the two: JWKS (asymmetric projects) or JWT secret (legacy HS256)
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
WEB_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
JOBS_SECRET=change-me
DEMO_KEY=change-me
# true only on demo deployments: enables the Reset demo buttons (they delete data)
DEMO_MODE=false
# read the customer IP from X-Forwarded-For (true behind Render/Vercel/Fly; false if exposed directly)
TRUST_PROXY=true
# M4
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# M5
WHATSAPP_MODE=simulator
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_CONFIRMED=slotpay_booking_confirmed
WHATSAPP_TEMPLATE_REMINDER=slotpay_appointment_reminder
WHATSAPP_TEMPLATE_CANCELLED=slotpay_booking_cancelled
